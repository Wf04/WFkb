#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer { // Layer 0 - QWERTY
            bindings = <
                &kp Q      &kp W      &kp E      &kp R      &kp T      &kp Y      &kp U      &kp I      &kp O      &kp P
                &kp A      &kp S      &kp D      &kp F      &kp G      &kp H      &kp J      &kp K      &kp L      &kp SEMI
                &kp Z      &kp X      &kp C      &kp V      &kp B      &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH
                &kp ESC    &kp LCTL   &kp LSHFT  &kp SPACE  &kp LALT   &kp CAPS   &kp TAB    &kp BSPC   &kp RET    &mo 1
            >;
        };

        fn_layer { // Layer 1 - Function / Numpad / Navigation
            bindings = <
                &none   &none     &none    &none       &none        &kp UP          &kp DOWN     &kp N7     &kp N8       &kp N9
                &none   &none     &none    &none       &none        &kp LEFT        &kp RIGHT    &kp N4     &kp N5       &kp N6
                &none   &none     &none    &none       &none        &none           &none        &kp N1     &kp N2       &kp N3 
                &tog 2  &kp PSCRN &kp LGUI &kp KP_PLUS &kp KP_MINUS &kp KP_ASTERISK &kp KP_SLASH &kp KP_DOT &kp KP_EQUAL &trans
            >;
        };

        bt_layer { // Layer 2 - Bluetooth
            bindings = <
                &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none  &none  &none  &none  &none  &none  &bt BT_CLR
                &none         &none         &none         &none  &none  &none  &none  &none  &none  &none
                &none         &none         &none         &none  &none  &none  &none  &none  &none  &none
                &tog 2        &none         &none         &trans &trans &trans &none  &none  &none  &trans
            >;
        };
    };
};
